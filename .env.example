# ---- MongoDB ----
# Lần chạy đầu, nếu database còn trống, server tự seed dữ liệu (xem README, mục Phase 3). Tắt bằng INIT_DATA=off
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=flower_shop

INIT_DATA=on

# ---- Auth (Phase 3) ----
# Dev: để trống cũng chạy (dùng khóa dev không an toàn). Production: BẮT BUỘC.
# Tạo bằng: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---- Admin ----
# Dùng khi seed admin lần đầu (tự động lúc server khởi động nếu chưa có admin) và cho `npm run seed:admin`.
# Dev: để trống ADMIN_PASSWORD thì dùng admin@example.com / Admin@12345. Production: bắt buộc điền.
# Mật khẩu ≥ 10 ký tự, có chữ hoa, chữ thường, chữ số.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# ---- Cloudinary (Phase 3) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SMTP — tùy chọn, để gửi email thông báo yêu cầu liên hệ (Phase 2) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFY_EMAIL=
